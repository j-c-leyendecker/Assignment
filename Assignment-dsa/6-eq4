#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
    Node* prev;
};

int main() {
    int n;
    cin >> n;
    Node* nodes[1005];
    Node* head = NULL;
    Node* tail = NULL;

    for (int i = 0; i < n; i++) {
        int x; cin >> x;
        nodes[i] = new Node{x, NULL, NULL};
        if (!head) head = tail = nodes[i];
        else {
            tail->next = nodes[i];
            nodes[i]->prev = tail;
            tail = nodes[i];
        }
    }

    int bad, wrong;
    cin >> bad >> wrong;
    nodes[bad]->next = nodes[wrong];

    Node* curr = head;
    while (curr && curr->next && curr->next->prev == curr) {
        curr = curr->next;
    }

    if (curr && curr->next) {
        Node* faulty = curr;
        Node* correctNext = NULL;
        Node* temp = head;
        while (temp) {
            if (temp != faulty && temp != faulty->next) {
                if (temp->next == faulty || !temp->next) {
                    correctNext = temp;
                    break;
                }
            }
            temp = temp->next;
        }
        if (correctNext) {
            faulty->next = correctNext->next;
            if (faulty->next) faulty->next->prev = faulty;
        }
    }

    Node* t = head;
    while (t) {
        cout << t->data;
        if (t->next) cout << "<->";
        t = t->next;
    }
    cout << endl;

    return 0;
}
