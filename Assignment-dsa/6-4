#include <iostream>
using namespace std;

struct Node {
    char data;
    Node* next;
    Node* prev;
} *head = NULL;

int main() {
    char ch;
    while (cin >> ch && ch != '\n') {
        Node* n = new Node{ch, NULL, head};
        if (head) head->prev = n;
        head = n;
    }
    Node* l = head, *r = head;
    if (r) while (r->next) r = r->next;
    while (l && r && l != r && l->prev != r) {
        if (l->data != r->data) { cout << "False" << endl; return 0; }
        l = l->next; r = r->prev;
    }
    cout << "True" << endl;
    return 0;
}
