#include <iostream>
using namespace std;

struct Node {
    int data;
    Node *next;
};

Node* reverseList(Node *head) {
    Node *prev = NULL;
    Node *curr = head;
    Node *nextNode;

    while (curr != NULL) {
        nextNode = curr->next;
        curr->next = prev;
        prev = curr;
        curr = nextNode;
    }
    return prev;
}

void print(Node *head) {
    while (head != NULL) {
        cout << head->data << "->";
        head = head->next;
    }
    cout << "NULL\n";
}

int main() {
    Node *head = new Node{1, NULL};
    head->next = new Node{2, NULL};
    head->next->next = new Node{3, NULL};
    head->next->next->next = new Node{4, NULL};

    cout << "Original: ";
    print(head);

    head = reverseList(head);

    cout << "Reversed: ";
    print(head);

    return 0;
}
