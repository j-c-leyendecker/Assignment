#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    int pid = fork();

    if (pid == 0) {
        printf("Child: I am exiting now.\n");
        exit(5); // child exits with status 5
    }

    else {
        int status;
        wait(&status); // parent waits

        printf("Parent: Child exited with code %d\n", WEXITSTATUS(status));
    }
    return 0;
}
