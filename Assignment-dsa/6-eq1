#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

Node* create(int val) {
    Node* n = new Node;
    n->data = val;
    n->next = NULL;
    return n;
}

int main() {
    int n; cin >> n;
    Node* head = NULL;
    Node* tail = NULL;
    for (int i = 0; i < n; i++) {
        int x; cin >> x;
        Node* newNode = create(x);
        if (!head) head = tail = newNode;
        else tail = tail->next = newNode;
    }
    if (head) tail->next = head;

    if (!head) return 0;

    Node *slow = head, *fast = head;
    while (fast->next != head && fast->next->next != head) {
        slow = slow->next;
        fast = fast->next->next;
    }

    Node* head2 = slow->next;
    slow->next = head;
    Node* temp = head2;
    while (temp->next != head) temp = temp->next;
    temp->next = head2;

    Node* t = head;
    do { cout << t->data; t = t->next; if (t != head) cout << "->"; } while (t != head);
    cout << " , ";
    t = head2;
    do { cout << t->data; t = t->next; if (t != head2) cout << "->"; } while (t != head2);
    cout << endl;

    return 0;
}
