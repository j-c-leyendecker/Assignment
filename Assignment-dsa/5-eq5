#include <iostream>
using namespace std;

struct Node {
    int data;
    Node *next;
};

void removeDuplicates(Node *head) {
    Node *ptr1 = head;
    Node *ptr2;
    Node *dup;

    while (ptr1 != NULL && ptr1->next != NULL) {
        ptr2 = ptr1;

        while (ptr2->next != NULL) {
            if (ptr1->data == ptr2->next->data) {
                dup = ptr2->next;
                ptr2->next = ptr2->next->next;
                delete dup;
            }
            else {
                ptr2 = ptr2->next;
            }
        }
        ptr1 = ptr1->next;
    }
}

int main() {
    Node *head = new Node{1, NULL};
    head->next = new Node{2, NULL};
    head->next->next = new Node{1, NULL};
    head->next->next->next = new Node{3, NULL};

    removeDuplicates(head);

    Node *temp = head;
    while (temp != NULL) {
        cout << temp->data << " ";
        temp = temp->next;
    }
}
