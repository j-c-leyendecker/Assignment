#include <iostream>
using namespace std;

struct Node {
    int data;
    Node *next;
};

bool detectLoop(Node *head) {
    Node *slow = head;
    Node *fast = head;

    while (fast != NULL && fast->next != NULL) {
        slow = slow->next;
        fast = fast->next->next;

        if (slow == fast)
            return true;
    }
    return false;
}

int main() {
    Node *head = new Node{1, NULL};
    head->next = new Node{2, NULL};
    head->next->next = new Node{3, NULL};

    // creating a loop
    head->next->next->next = head;

    if (detectLoop(head))
        cout << "Loop found\n";
    else
        cout << "No loop\n";

    return 0;
}
