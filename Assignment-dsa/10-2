#include <iostream>
#include <unordered_set>
using namespace std;

int main() {
    int n, m;
    cin >> n;
    int a[1005];
    for(int i = 0; i < n; i++) cin >> a[i];
    cin >> m;
    int b[1005];
    for(int i = 0; i < m; i++) cin >> b[i];
    unordered_set<int> s;
    for(int i = 0; i < n; i++) s.insert(a[i]);
    for(int i = 0; i < m; i++) {
        if(s.count(b[i])) cout << b[i] << " ";
    }
    cout << endl;
    return 0;
}
