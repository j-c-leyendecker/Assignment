#include <iostream>
using namespace std;

int main() {
    int n; 
    cin >> n;
    int a[1005];
    int max_val = 0;
    for(int i = 0; i < n; i++) {
        cin >> a[i];
        if(a[i] > max_val) max_val = a[i];
    }

    int count[100005] = {0};
    for(int i = 0; i < n; i++) count[a[i]]++;

    for(int i = 0; i <= max_val; i++) {
        for(int j = 0; j < count[i]; j++) {
            cout << i << " ";
        }
    }
    cout << endl;
    return 0;
}
