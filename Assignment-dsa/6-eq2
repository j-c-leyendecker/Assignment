#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
    Node* prev;
};

int parity(int n) {
    int cnt = 0;
    while (n) { cnt += n & 1; n >>= 1; }
    return cnt;
}

void removeEven(Node*& head) {
    if (!head) return;
    Node* curr = head;
    do {
        if (parity(curr->data) % 2 == 0) {
            if (curr->prev) curr->prev->next = curr->next;
            if (curr->next) curr->next->prev = curr->prev;
            if (curr == head) head = curr->next;
            Node* temp = curr;
            curr = curr->next;
            delete temp;
        } else {
            curr = curr->next;
        }
    } while (head && curr != head);
}

int main() {
    int n; cin >> n;
    Node* head = NULL;
    Node* tail = NULL;
    for (int i = 0; i < n; i++) {
        int x; cin >> x;
        Node* newNode = new Node{x, NULL, NULL};
        if (!head) head = tail = newNode;
        else {
            tail->next = newNode;
            newNode->prev = tail;
            tail = newNode;
        }
    }
    if (head) tail->next = head;
    if (head) head->prev = tail;

    removeEven(head);

    if (!head) { cout << "Empty" << endl; return 0; }
    Node* t = head;
    do {
        cout << t->data;
        t = t->next;
        if (t != head) cout << "->";
    } while (t != head);
    cout << endl;

    return 0;
}
