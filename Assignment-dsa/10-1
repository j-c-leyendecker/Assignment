#include <iostream>
#include <unordered_set>
using namespace std;

int main() {
    int n;
    cin >> n;
    int nums[1005];
    for(int i = 0; i < n; i++) cin >> nums[i];
    unordered_set<int> s;
    for(int i = 0; i < n; i++) {
        if(s.count(nums[i])) {
            cout << "true" << endl;
            return 0;
        }
        s.insert(nums[i]);
    }
    cout << "false" << endl;
    return 0;
}
