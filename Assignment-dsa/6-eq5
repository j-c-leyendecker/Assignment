#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
    Node* prev;
    Node* up;
    Node* down;
};

int main() {
    int r, c;
    cin >> r >> c;
    Node* grid[105][105];

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            int x; cin >> x;
            grid[i][j] = new Node{x, NULL, NULL, NULL, NULL};
        }
    }

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            if (j < c-1) {
                grid[i][j]->next = grid[i][j+1];
                grid[i][j+1]->prev = grid[i][j];
            }
            if (i < r-1) {
                grid[i][j]->down = grid[i+1][j];
                grid[i+1][j]->up = grid[i][j];
            }
        }
    }

    cout << "2D Doubly Linked List Created Successfully!" << endl;
    cout << "Sample Traversal (Row-wise):" << endl;
    for (int i = 0; i < r; i++) {
        Node* t = grid[i][0];
        while (t) {
            cout << t->data << " ";
            t = t->next;
        }
        cout << endl;
    }

    return 0;
}
