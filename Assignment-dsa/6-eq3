#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
    Node* prev;
};

Node* reverseK(Node* head, int k) {
    if (!head) return head;
    Node* curr = head;
    Node* prev = NULL;
    Node* next = NULL;
    int count = 0;

    while (curr && count < k) {
        next = curr->next;
        curr->next = prev;
        curr->prev = next == NULL ? prev : next;
        prev = curr;
        curr = next;
        count++;
    }

    if (next != NULL) {
        head->next = reverseK(next, k);
        if (head->next) head->next->prev = head;
    }
    return prev;
}

int main() {
    int n, k;
    cin >> n >> k;
    Node* head = NULL;
    Node* tail = NULL;
    for (int i = 0; i < n; i++) {
        int x; cin >> x;
        Node* newNode = new Node{x, NULL, NULL};
        if (!head) head = tail = newNode;
        else {
            tail->next = newNode;
            newNode->prev = tail;
            tail = newNode;
        }
    }

    head = reverseK(head, k);

    Node* t = head;
    while (t) {
        cout << t->data;
        if (t->next) cout << "<->";
        t = t->next;
    }
    cout << endl;

    return 0;
}
